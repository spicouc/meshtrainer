#!/usr/bin/env bash
# MeshTrainer launcher — Phase 3 (v1.4.0)
# ./meshtrainer {start|stop|restart|status|logs}
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

PY_BIN="${PYTHON_BIN:-$SCRIPT_DIR/.venv/bin/python}"
if [ ! -x "$PY_BIN" ]; then
    # fallback: python del PATH (si el venv no existeix encara)
    PY_BIN="$(command -v python3 || true)"
fi
[ -n "$PY_BIN" ] && [ -x "$PY_BIN" ] || die "No trobo Python — executa primer: ./install.sh"
PID_FILE="$SCRIPT_DIR/app_storage/meshtrainer.pid"
LOG_FILE="$SCRIPT_DIR/app_storage/meshtrainer.log"
HOST="${APP_HOST:-127.0.0.1}"
PORT="${APP_PORT:-8000}"

# ── helpers ────────────────────────────────────────────────────────────────
info() { printf '\033[1;34m[meshtrainer]\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m[ok]\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2; exit 1; }

app_pid() {
    [ -f "$PID_FILE" ] && cat "$PID_FILE" 2>/dev/null || true
}

is_running() {
    local pid; pid="$(app_pid)"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

wait_healthy() {
    local tries=0
    while [ $tries -lt 60 ]; do
        if "$PY_BIN" -c "
import urllib.request
try:
    urllib.request.urlopen('http://$HOST:$PORT/api/health', timeout=2)
    exit(0)
except Exception:
    exit(1)
" 2>/dev/null; then
            return 0
        fi
        tries=$((tries+1)); sleep 1
    done
    return 1
}

cmd_start() {
    if is_running; then
        info "MeshTrainer ja està en marxa (PID $(app_pid))."
        return 0
    fi
    [ -x "$PY_BIN" ] || die "No trobo .venv — executa primer: ./install.sh"
    mkdir -p "$SCRIPT_DIR/app_storage"
    info "Arrencant MeshTrainer a http://$HOST:$PORT …"
    nohup "$PY_BIN" -m uvicorn app.api.main:app \
        --host "$HOST" --port "$PORT" \
        >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    if wait_healthy; then
        ok "MeshTrainer en marxa: http://$HOST:$PORT (PID $(app_pid))"
    else
        die "El servei no ha respost a /api/health en 60s — revisa: ./meshtrainer logs"
    fi
}

cmd_stop() {
    if ! is_running; then
        info "MeshTrainer no està en marxa."
        rm -f "$PID_FILE"
        return 0
    fi
    local pid; pid="$(app_pid)"
    info "Aturant MeshTrainer (PID $pid) …"
    kill "$pid" 2>/dev/null || true
    local tries=0
    while kill -0 "$pid" 2>/dev/null && [ $tries -lt 15 ]; do tries=$((tries+1)); sleep 1; done
    if kill -0 "$pid" 2>/dev/null; then
        info "Forçant l'aturada (PID $pid)…"
        kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
    ok "MeshTrainer aturat."
}

cmd_status() {
    if is_running; then
        local pid; pid="$(app_pid)"
        echo "MeshTrainer: RUNNING (PID $pid, http://$HOST:$PORT)"
        "$PY_BIN" -c "
import urllib.request, json
try:
    r = json.loads(urllib.request.urlopen('http://$HOST:$PORT/api/health', timeout=3).read())
    print('health:', r.get('data', {}).get('ok'))
except Exception as e:
    print('health: NO RESPON')
"
    else
        echo "MeshTrainer: STOPPED"
    fi
}

cmd_logs() {
    if [ -f "$LOG_FILE" ]; then
        tail -n "${1:-50}" "$LOG_FILE"
    else
        info "No hi ha logs encara (app_storage/meshtrainer.log)."
    fi
}

# ── dispatch ───────────────────────────────────────────────────────────────
case "${1:-}" in
    start)   cmd_start ;;
    stop)    cmd_stop ;;
    restart) cmd_stop; cmd_start ;;
    status)  cmd_status ;;
    logs)    cmd_logs "${2:-50}" ;;
    *) echo "ús: ./meshtrainer {start|stop|restart|status|logs [n]}"; exit 1 ;;
esac
