+    check("LN2: round 2 index", r2idx == 2)
+    # r10 on top of CLOSED r2 -> index 3 (NOT lexical order: "r10" > "r2" numerically)
+    r10 = coord.round_open("run1", "r10", {}, parent_round_id="r2")
